# ============================================================
# BOLTZ SUPLEMENTOS - CONFIGURAÇÕES DO BACKEND
# ============================================================

# ------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------

PROJECT_NAME="Boltz Suplementos"

# Valores esperados: local, staging ou production
ENVIRONMENT=local


# ------------------------------------------------------------
# API e autenticação
# ------------------------------------------------------------

API_V1_STR=/api/v1

# Gere uma chave segura antes de publicar a aplicação
SECRET_KEY="substitua-por-uma-chave-secreta-segura"

# 60 minutos * 24 horas * 8 dias = 11520 minutos
ACCESS_TOKEN_EXPIRE_MINUTES=11520


# ------------------------------------------------------------
# CORS
# ------------------------------------------------------------

# Separe as URLs por vírgula, sem colchetes.
# Não coloque barra "/" no final das URLs.
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173


# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD="substitua-pela-senha-do-postgres"
POSTGRES_DB=boltz_suplementos


# ------------------------------------------------------------
# E-mail / SMTP
# ------------------------------------------------------------

# Deixe SMTP_HOST vazio caso o envio de e-mails ainda não seja usado.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=

# Deixe vazio enquanto o SMTP não estiver configurado.
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME="Boltz Suplementos"


# ------------------------------------------------------------
# Primeiro administrador
# ------------------------------------------------------------

FIRST_SUPERUSER="substitua-por-um-email-administrador"
FIRST_SUPERUSER_PASSWORD="substitua-por-uma-senha-segura"

# ------------------------------------------------------------
# Segurança
# ------------------------------------------------------------

ALGORITHM="HS256"

# ------------------------------------------------------------
# Sentry
# ------------------------------------------------------------

# Opcional. Deixe vazio se não estiver utilizando o Sentry.
SENTRY_DSN=